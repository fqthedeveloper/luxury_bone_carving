# ==============================================================================
# JALALUDDIN BONE CARVING - PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Copy this file to .env on your production server (e.g., PythonAnywhere, Render, AWS, VPS)
# and replace placeholder values with your real live credentials.
# NEVER commit the filled .env file with live secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE DJANGO CONFIGURATION
# ------------------------------------------------------------------------------
# Must be False in production! Never set DJANGO_DEBUG=True on a live server.
DJANGO_DEBUG=False

# Generate a strong 64-character random string.
# Example command to generate one: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-with-a-very-long-and-cryptographically-secure-random-secret-key-at-least-50-chars

# Comma-separated list of domains allowed to serve this Django application.
# Include your backend domain, custom domain, and pythonanywhere domain.
DJANGO_ALLOWED_HOSTS=borncarvingbackend.pythonanywhere.com,api.luxurybonecarving.com,.pythonanywhere.com,.netlify.app

# Custom CSRF trusted origins (comma-separated, https://...)
DJANGO_CSRF_TRUSTED_ORIGINS=https://testing-born-carving.netlify.app,https://borncarvingbackend.pythonanywhere.com,https://luxurybonecarving.com

# Frontend public application URL (used for email links, payment redirects, etc.)
FRONTEND_URL=https://testing-born-carving.netlify.app

# Production Security & SSL enforcement
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://testing-born-carving.netlify.app,https://luxurybonecarving.com

# ------------------------------------------------------------------------------
# 2. EMAIL SMTP CONFIGURATION (Transactional emails, OTP, Inquiries, Order receipts)
# ------------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=fqthedeveloper@gmail.com
EMAIL_HOST_PASSWORD=yqsg vlor inaj nxzl
DEFAULT_FROM_EMAIL=concierge@luxurybonecarving.com
ADMIN_EMAIL=concierge@luxurybonecarving.com

# ------------------------------------------------------------------------------
# 3. PAYMENT GATEWAY CREDENTIALS (Live Production Keys)
# ------------------------------------------------------------------------------
# Razorpay Live API Keys (from https://dashboard.razorpay.com/app/keys)
# Live key IDs start with "rzp_live_" (NOT "rzp_test_")
RAZORPAY_KEY_ID=rzp_live_your_live_key_id_here
RAZORPAY_KEY_SECRET=your_live_razorpay_secret_here

# Surcharge / Convenience fee percentage (2.0 = 2%)
GATEWAY_FEE_PERCENT=2.0

# Stripe Live API Keys (from https://dashboard.stripe.com/apikeys)
# Live keys start with "pk_live_" and "sk_live_"
STRIPE_PUBLIC_KEY=pk_live_your_live_stripe_public_key
STRIPE_SECRET_KEY=sk_live_your_live_stripe_secret_key

# PayPal Live Client ID (from https://developer.paypal.com/dashboard/applications/live)
PAYPAL_CLIENT_ID=your_live_paypal_client_id_here

# ------------------------------------------------------------------------------
# 4. DATABASE CONFIGURATION (Optional - defaults to SQLite3 with 20s timeout)
# ------------------------------------------------------------------------------
# If migrating to PostgreSQL or MySQL on PythonAnywhere / RDS / Supabase:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=your_prod_db
# DB_USER=your_prod_user
# DB_PASSWORD=your_prod_password
# DB_HOST=your_prod_host
# DB_PORT=5432
